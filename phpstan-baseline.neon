parameters:
	ignoreErrors:
		-
			message: '#^Loose comparison via "\=\=" is not allowed\.$#'
			identifier: equal.notAllowed
			count: 1
			path: src/Builder/ArchiveBuilder.php

		-
			message: '#^Parameter \#1 \$names of method Composer\\Satis\\Builder\\ArchiveBuilderHelper\:\:isOneOfNamesInList\(\) expects list\<string\>, array\<string\> given\.$#'
			identifier: argument.type
			count: 2
			path: src/Builder/ArchiveBuilderHelper.php

		-
			message: '#^Loose comparison via "\=\=" is not allowed\.$#'
			identifier: equal.notAllowed
			count: 2
			path: src/Console/Command/AddCommand.php

		-
			message: '#^Casting to string something that''s already string\.$#'
			identifier: cast.useless
			count: 1
			path: src/Console/Command/BuildCommand.php

		-
			message: '#^Call to function is_a\(\) with Composer\\Package\\Link and ''Composer\\\\Package\\\\Link'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/PackageSelection/PackageSelection.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/PackageSelection/PackageSelection.php

		-
			message: '#^Loose comparison via "\!\=" is not allowed\.$#'
			identifier: notEqual.notAllowed
			count: 1
			path: src/PackageSelection/PackageSelection.php

		-
			message: '#^Loose comparison via "\=\=" is not allowed\.$#'
			identifier: equal.notAllowed
			count: 1
			path: src/PackageSelection/PackageSelection.php

		-
			message: '#^PHPDoc tag @var with type string\|null is not subtype of native type string\.$#'
			identifier: varTag.nativeType
			count: 1
			path: src/PackageSelection/PackageSelection.php

		-
			message: '#^Parameter \#2 \$array of function implode expects array, array\<string\>\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/PackageSelection/PackageSelection.php

		-
			message: '#^AnonymousClassdd4f4d5d0a10081f3f8b9c19006facf2\:\:__construct\(\) does not call parent constructor from Composer\\Package\\Archiver\\ArchiveManager\.$#'
			identifier: constructor.missingParentCall
			count: 1
			path: tests/Builder/ArchiveBuilderTest.php

		-
			message: '#^Deprecated in PHP 8\.4\: Parameter \#4 \$fileName \(string\) is implicitly nullable via default value null\.$#'
			identifier: parameter.implicitlyNullable
			count: 1
			path: tests/Builder/ArchiveBuilderTest.php

		-
			message: '#^Parameter \#2 \$replace of function str_replace expects array\<string\>\|string, array\<int, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Builder/PackagesBuilderDumpTest.php

		-
			message: '#^Possibly invalid array key type int\|string\|null\.$#'
			identifier: offsetAccess.invalidOffset
			count: 1
			path: tests/Builder/PackagesBuilderDumpTest.php

		-
			message: '#^Deprecated in PHP 8\.4\: Parameter \#3 \$filterRepos \(array\) is implicitly nullable via default value null\.$#'
			identifier: parameter.implicitlyNullable
			count: 1
			path: tests/PackageSelection/PackageSelectionTest.php

		-
			message: '#^Deprecated in PHP 8\.4\: Parameter \#4 \$filterPackages \(array\) is implicitly nullable via default value null\.$#'
			identifier: parameter.implicitlyNullable
			count: 1
			path: tests/PackageSelection/PackageSelectionTest.php

		-
			message: '#^Offset ''url'' on array\{package\: array\<mixed\>\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: tests/PackageSelection/PackageSelectionTest.php

		-
			message: '#^Parameter \#1 \$array \(array\{Composer\\Package\\Package, Composer\\Package\\Package, Composer\\Package\\Package\}\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: tests/PackageSelection/PackageSelectionTest.php

